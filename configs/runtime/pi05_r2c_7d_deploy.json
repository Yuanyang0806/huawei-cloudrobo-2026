{
  "model_feature_mapping": {
    "input_features": {
      "observation.state": {
        "shape": [
          7
        ],
        "dtype": "float32",
        "values": [
          "observation.joint_states.position@{arm_joint1}",
          "observation.joint_states.position@{arm_joint2}",
          "observation.joint_states.position@{arm_joint3}",
          "observation.joint_states.position@{arm_joint4}",
          "observation.joint_states.position@{arm_joint5}",
          "observation.joint_states.position@{arm_joint6}",
          "observation.joint_states.position@{gripper}"
        ]
      },
      "observation.images.cam_external": {
        "dtype": "uint8",
        "value": "observations.images.color.front"
      },
      "observation.images.cam_wrist": {
        "dtype": "uint8",
        "value": "observations.images.color.wrist"
      },
      "task": {
        "type": "PROMPT"
      }
    },
    "output_features": {
      "action": {
        "chunk_size": 50,
        "shape": [
          7
        ],
        "values": [
          "actions.joint_states.position@{arm_joint1}",
          "actions.joint_states.position@{arm_joint2}",
          "actions.joint_states.position@{arm_joint3}",
          "actions.joint_states.position@{arm_joint4}",
          "actions.joint_states.position@{arm_joint5}",
          "actions.joint_states.position@{arm_joint6}",
          "actions.joint_states.position@{gripper}"
        ]
      }
    }
  },
  "stop_condition": {
    "max_iter_num": 60,
    "max_run_time": 5
  }
}
