#!/usr/bin/env python3

import json
import os
import sys
from copy import deepcopy
from pathlib import Path

from lerobot.datasets.lerobot_dataset import LeRobotDataset
from lerobot.utils.constants import DEFAULT_FEATURES


# ============================================================
# 配置
# ============================================================

BASE = Path.home() / ".cache/huggingface/lerobot/liuyy"

SRC_FPS = 30
DST_FPS = 10
STRIDE = SRC_FPS // DST_FPS

if SRC_FPS % DST_FPS != 0:
    raise RuntimeError(
        f"当前脚本要求整数抽帧比例，得到 {SRC_FPS}/{DST_FPS}"
    )


# ============================================================
# 1. 自动寻找最近生成的 merged 数据集
#
# 也可以手动指定：
#
# SRC_ROOT=/path/to/dataset python scripts/downsample_merged_30_to_10.py
# ============================================================

manual_src = os.environ.get("SRC_ROOT")

if manual_src:
    SRC_ROOT = Path(manual_src).expanduser().resolve()

else:
    candidates = []

    for d in BASE.glob("site_clear_table_group6_merged_*"):

        # 不要再次选择已经转换过的 _10fps
        if d.name.endswith("_10fps"):
            continue

        info_path = d / "meta" / "info.json"

        if not info_path.exists():
            continue

        try:
            info = json.loads(
                info_path.read_text(encoding="utf-8")
            )
        except Exception:
            continue

        if int(info.get("fps", -1)) != SRC_FPS:
            continue

        candidates.append(d)

    if not candidates:
        raise RuntimeError(
            "没有找到可用的 30fps merged 数据集。\n"
            "可以手动使用：\n"
            "SRC_ROOT=/完整路径 python scripts/downsample_merged_30_to_10.py"
        )

    # 选择最后修改时间最新的 merged dataset
    candidates.sort(
        key=lambda p: p.stat().st_mtime
    )

    SRC_ROOT = candidates[-1]


SRC_INFO_PATH = SRC_ROOT / "meta" / "info.json"

if not SRC_INFO_PATH.exists():
    raise RuntimeError(
        f"源数据集不存在 meta/info.json:\n{SRC_INFO_PATH}"
    )


# ============================================================
# 2. 读取源数据集信息
# ============================================================

src_info = json.loads(
    SRC_INFO_PATH.read_text(encoding="utf-8")
)

source_fps = int(src_info.get("fps", -1))

if source_fps != SRC_FPS:
    raise RuntimeError(
        f"源数据集不是 {SRC_FPS} fps，而是 {source_fps} fps"
    )

SRC_NAME = SRC_ROOT.name

DST_NAME = f"{SRC_NAME}_10fps"
DST_ROOT = BASE / DST_NAME

SRC_REPO_ID = f"liuyy/{SRC_NAME}"
DST_REPO_ID = f"liuyy/{DST_NAME}"


print("=" * 80)
print("LeRobot Dataset Downsample")
print("=" * 80)

print("Source:")
print(f"  repo      : {SRC_REPO_ID}")
print(f"  root      : {SRC_ROOT}")
print(f"  fps       : {src_info.get('fps')}")
print(f"  episodes  : {src_info.get('total_episodes')}")
print(f"  frames    : {src_info.get('total_frames')}")

print()

print("Destination:")
print(f"  repo      : {DST_REPO_ID}")
print(f"  root      : {DST_ROOT}")
print(f"  fps       : {DST_FPS}")

print()

print(f"Sampling: every {STRIDE} frames")
print("30 fps -> keep frames 0, 3, 6, 9, ... -> 10 fps")

print("=" * 80)


# ============================================================
# 3. 防止覆盖
# ============================================================

if DST_ROOT.exists():

    print()
    print("ERROR: 输出目录已经存在：")
    print(DST_ROOT)
    print()
    print("为防止覆盖已有转换结果，停止。")
    sys.exit(1)


# ============================================================
# 4. 加载源数据集
#
# 显式使用 pyav，绕开当前机器 torchcodec / libavutil 问题
# ============================================================

print()
print("[1/4] 加载 30fps 源数据集...")

src = LeRobotDataset(
    repo_id=SRC_REPO_ID,
    root=SRC_ROOT,
    video_backend="pyav",
    return_uint8=True,
    token=False,
)

print("Source loaded.")
print("num_episodes =", src.num_episodes)
print("num_frames   =", src.num_frames)
print("fps          =", src.fps)


# ============================================================
# 5. 创建 10fps 数据集
#
# DEFAULT_FEATURES:
# timestamp
# frame_index
# episode_index
# index
# task_index
#
# 这些字段不能直接复制，由 LeRobot 自动重新生成
# ============================================================

user_features = {
    key: deepcopy(value)
    for key, value in src.features.items()
    if key not in DEFAULT_FEATURES
}

robot_type = src_info.get("robot_type", None)

print()
print("[2/4] 创建新的 10fps 数据集...")

dst = LeRobotDataset.create(
    repo_id=DST_REPO_ID,
    root=DST_ROOT,
    fps=DST_FPS,
    features=user_features,
    robot_type=robot_type,
    use_videos=True,

    # 两路相机写盘
    image_writer_processes=0,
    image_writer_threads=8,

    # 每个 episode 保存后立即编码
    batch_encoding_size=1,

    # 后续读取也使用 pyav
    video_backend="pyav",
)


# ============================================================
# 6. 按 episode 抽帧
#
# 每三个 30Hz sample 保留一个：
#
# 0 /30 = 0.0s
# 3 /30 = 0.1s
# 6 /30 = 0.2s
#
# 新数据自动生成：
#
# 0 /10 = 0.0s
# 1 /10 = 0.1s
# 2 /10 = 0.2s
#
# 因此动作 / 状态 / 图像严格同步。
# ============================================================

print()
print("[3/4] 开始抽帧并重建 Episodes...")
print()

expected_total_frames = 0

for ep_idx in range(src.num_episodes):

    ep_meta = src.meta.episodes[ep_idx]

    start = int(ep_meta["dataset_from_index"])
    end = int(ep_meta["dataset_to_index"])

    original_len = end - start

    selected_indices = range(
        start,
        end,
        STRIDE,
    )

    selected_count = (
        original_len + STRIDE - 1
    ) // STRIDE

    expected_total_frames += selected_count

    print(
        f"Episode {ep_idx:03d}/{src.num_episodes - 1:03d}: "
        f"{original_len} -> {selected_count} frames"
    )

    for src_idx in selected_indices:

        sample = src[src_idx]

        # LeRobot Writer 要求 task 单独提供
        new_frame = {
            "task": sample["task"]
        }

        # 复制真正的数据字段
        #
        # 包括：
        # observation.state
        # action
        # observation.images.cam_external
        # observation.images.cam_wrist
        # 以及其他用户定义字段
        for key in user_features:

            if key not in sample:
                raise KeyError(
                    f"源 frame 缺少 feature: {key}"
                )

            value = sample[key]

            # 保证 Tensor 在 CPU
            if hasattr(value, "cpu"):
                value = value.cpu()

            new_frame[key] = value

        dst.add_frame(new_frame)

    # LeRobot 自动：
    # - 生成新 frame_index
    # - 生成新 timestamp
    # - 生成 index
    # - 保存 action/state
    # - 编码视频
    # - 更新 episode metadata/stats
    dst.save_episode(
        parallel_encoding=True
    )


# ============================================================
# 7. 完成数据集
# ============================================================

print()
print("[4/4] Finalizing dataset...")

dst.finalize()

print()
print("=" * 80)
print("Downsample finished")
print("=" * 80)
print(f"Output: {DST_ROOT}")
print(f"Repo  : {DST_REPO_ID}")
print(f"FPS   : {DST_FPS}")
print(f"Episodes expected : {src.num_episodes}")
print(f"Frames expected   : {expected_total_frames}")
print("=" * 80)
